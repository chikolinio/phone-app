{
  "name": "daily-command-center",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/model.test.ts && node --experimental-strip-types tests/storage.test.ts",
    "format": "prettier --write app src tests *.json README.md",
    "format:check": "prettier --check app src tests *.json README.md"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2"
  },
  "type": "module"
}
